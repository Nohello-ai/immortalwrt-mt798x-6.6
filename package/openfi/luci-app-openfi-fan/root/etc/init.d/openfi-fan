#!/bin/sh /etc/rc.common
#
# OpenFi 6C 风扇守护进程
#   start/stop/restart 由 procd 管（挂了会自动拉起）
#   reload 发 SIGHUP，让守护进程重新读 UCI —— 风扇不会中断
#
START=98
STOP=12
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/openfi-fan
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	local pids

	pids=$(pgrep -f '/usr/sbin/openfi-fan$' 2>/dev/null)
	if [ -n "$pids" ]; then
		for p in $pids; do kill -HUP "$p" 2>/dev/null; done
	else
		# 进程不在（异常退出）→ 直接拉起来
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger openfi
}
