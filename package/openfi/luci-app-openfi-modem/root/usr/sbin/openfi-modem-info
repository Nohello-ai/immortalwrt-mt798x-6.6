#!/bin/sh
#
# OpenFi 6C —— 5G 模块信息查询（只读）
#
# 只发查询类指令：ATI / AT+CGMM / AT+CGSN / AT+xxx? ……
# 一条写指令都不发，所以查询本身不会动模块当前的驻网和数据连接。
#
# 输出：一行 JSON，给 LuCI「移动网络」页面（view/openfi/modem.js）读取。
# 任何一步失败都输出空字段并 exit 0，绝不让页面报错白屏。
#
# 用法：
#   openfi-modem-info          打印 JSON
#   openfi-modem-info --raw    打印 AT 口 + 模块原始回显（排障用）

. /usr/lib/openfi-modem/at.sh

RAW=""

# ------------------------------------------------------------ 一次发完的查询
run_query() {
	omod_query \
		ATI \
		AT+CGMI \
		AT+CGMM \
		AT+CGMR \
		AT+CGSN \
		'AT+CPIN?' \
		AT+CSQ \
		AT+CESQ \
		AT+QRSRP \
		'AT+COPS?' \
		AT+QNWINFO \
		'AT+QUIMSLOT?' \
		'AT+QUIMSLOT=?' \
		AT+QTEMP \
		AT+QCCID \
		AT+CIMI \
		'AT+CREG?' \
		'AT+CEREG?' \
		AT+QCAINFO
}

# 某条指令响应里的第一行非空内容（依赖模块回显）
sec1() {
	omod_sec "$1" "$2" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' | head -1
}

# ------------------------------------------------------------ 采集
if omod_open; then
	RAW="$(run_query)"
	omod_close
fi

if [ "$1" = "--raw" ]; then
	printf 'AT_PORT=%s\nAT_ERR=%s\n--- raw ---\n%s\n' "$AT_PORT" "$AT_ERR" "$RAW"
	exit 0
fi

# ------------------------------------------------------------ 解析
MODEL="$(sec1 "$RAW" 'AT+CGMM')"
MANUF="$(sec1 "$RAW" 'AT+CGMI')"
REV="$(sec1 "$RAW" 'AT+CGMR')"
IMEI="$(omod_sec "$RAW" 'AT+CGSN' | tr -d '\r' | grep -E '^[0-9]{15}$' | head -1)"

# 回显被关掉时上面的分段解析会全空，用整段正则兜底
[ -z "$MODEL" ] && MODEL="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -oE '[A-Z]{2}[0-9]{3,4}[A-Z]?-[A-Z]{2}' | head -1)"
[ -z "$MANUF" ] && MANUF="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -ioE 'quectel|fibocom|simcom|meig|unisoc|mediatek|longsung|neoway' | head -1)"
[ -z "$REV" ] && REV="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -iE '^[[:space:]]*revision' | head -1 | sed 's/.*[Rr]evision[[:space:]]*:[[:space:]]*//')"
[ -z "$IMEI" ] && IMEI="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -E '^[0-9]{15}$' | head -1)"

SIM_STATUS="$(omod_after_colon "$(omod_line "$RAW" '+CPIN:')")"
[ -z "$SIM_STATUS" ] && SIM_STATUS="$(omod_sec "$RAW" 'AT+CPIN?' | sed -e '/^$/d' | head -1)"

# 当前卡槽 / 支持的卡槽
SLOT_LINE="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -E '\+(QUIMSLOT|QUSIMSLOT):' | grep -v -F '(' | head -1)"
SLOTS_LINE="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -E '\+(QUIMSLOT|QUSIMSLOT):' | grep -F '(' | head -1)"
SIM_SLOT="$(omod_after_colon "$SLOT_LINE" | tr -dc '0-9')"
SIM_SLOTS="$(printf '%s' "$SLOTS_LINE" | sed 's/.*(//; s/).*//' | tr -dc '0-9,')"

# 信号
CSQ="$(omod_after_colon "$(omod_line "$RAW" '+CSQ:')" | cut -d, -f1 | tr -dc '0-9')"
DBM=""
case "$CSQ" in
	''|99) DBM="" ;;
	*) DBM="$(( -113 + 2 * CSQ ))" ;;
esac

# 首选移远的 +QRSRP（5G 下才准），没有就退回 +CESQ 第 6 个字段
RSRP="$(omod_first_int "$(omod_after_colon "$(omod_line "$RAW" '+QRSRP:')")")"
if [ -z "$RSRP" ]; then
	CESQ6="$(omod_after_colon "$(omod_line "$RAW" '+CESQ:')" | cut -d, -f6 | tr -dc '0-9-')"
	case "$CESQ6" in
		''|*-) : ;;
		*) RSRP="$(( CESQ6 - 140 ))" ;;
	esac
fi

# 网络制式 / 运营商
NETWORK="$(printf '%s' "$(omod_line "$RAW" '+QNWINFO:')" | cut -d'"' -f2)"
OPERATOR="$(printf '%s' "$(omod_line "$RAW" '+COPS:')" | cut -d'"' -f2)"

# 模块温度：+QTEMP 第一个数字就是 modem 温度
TEMPERATURE="$(omod_first_int "$(omod_after_colon "$(omod_line "$RAW" '+QTEMP:')")")"

# SIM 卡：ICCID（卡号）/ IMSI（用户标识）
ICCID="$(omod_sec "$RAW" 'AT+QCCID' | tr -d '\r' | grep -E '[0-9]{15,22}' | head -1 | tr -dc '0-9')"
[ -z "$ICCID" ] && ICCID="$(printf '%s\n' "$RAW" | tr -d '\r' | sed -n 's/^+QCCID:[[:space:]]*//p' | head -1 | tr -dc '0-9')"
IMSI="$(omod_sec "$RAW" 'AT+CIMI' | tr -d '\r' | grep -E '^[0-9]{14,16}$' | head -1)"
[ -z "$IMSI" ] && IMSI="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -E '^[0-9]{14,16}$' | head -1)"

# 网络注册状态：优先 EPS(CEREG)，退回 CS(CREG)
# 0 未注册 1 已注册(本地) 2 搜索中 3 拒绝 4 未知 5 已注册(漫游)
reg_code() {
	printf '%s\n' "$RAW" | tr -d '\r' | grep -E "\+$1:" | head -1 | sed 's/.*,//' | tr -dc '0-9'
}
reg_text() {
	case "$1" in
		0) echo "未注册" ;;
		1) echo "已注册（本地）" ;;
		2) echo "正在搜网" ;;
		3) echo "注册被拒" ;;
		4) echo "状态未知" ;;
		5) echo "已注册（漫游）" ;;
		'') echo "" ;;
		*) echo "状态 $1" ;;
	esac
}
REG_CODE="$(reg_code CEREG)"
[ -n "$REG_CODE" ] || REG_CODE="$(reg_code CREG)"
REG_STATUS="$(reg_text "$REG_CODE")"

# 小区信息：+QCAINFO: "PCC",1650,75,"LTE BAND 3",1,300,-98,-11,-65,12
# 取每行的 类型 / 频段 / 末尾 4 个数字（移远文档顺序：RSRP, RSRQ, RSSI, SINR）
CELLS_JSON="$(printf '%s\n' "$RAW" | tr -d '\r' | grep -F '+QCAINFO:' | awk '
{
	line = $0
	sub(/^[^:]*:[[:space:]]*/, "", line)
	n = split(line, f, ",")

	type = ""; band = ""
	for (i = 1; i <= n; i++) {
		gsub(/"/, "", f[i])
		gsub(/^[[:space:]]+|[[:space:]]+$/, "", f[i])
		if (f[i] ~ /BAND/) { if (band == "") band = f[i] }
		else if (type == "" && f[i] ~ /^(PCC|SCC|LTE|NR)/) type = f[i]
	}

	cnt = 0
	for (i = 1; i <= n; i++)
		if (f[i] ~ /^-?[0-9]+$/) nums[++cnt] = f[i]

	if (band == "" && cnt == 0) next

	rsrp = (cnt >= 4) ? nums[cnt-3] : "null"
	rsrq = (cnt >= 3) ? nums[cnt-2] : "null"
	rssi = (cnt >= 2) ? nums[cnt-1] : "null"
	sinr = (cnt >= 1) ? nums[cnt]   : "null"

	printf "%s{\"type\":\"%s\",\"band\":\"%s\",\"rsrp\":%s,\"rsrq\":%s,\"rssi\":%s,\"sinr\":%s}",
		(m++ ? "," : ""), type, band, rsrp, rsrq, rssi, sinr
}')"

# ------------------------------------------------------------ 输出
SLOTS_JSON='[]'
if [ -n "$SIM_SLOTS" ]; then
	SLOTS_JSON="[$(printf '%s' "$SIM_SLOTS" | awk -F, '{for(i=1;i<=NF;i++){if($i=="")continue; printf "%s\"%s\"", (n++?",":""), $i}}')]"
fi

cat <<EOF
{
  "at_port": "$(omod_json_escape "$AT_PORT")",
  "error": "$(omod_json_escape "$AT_ERR")",
  "model": "$(omod_json_escape "$MODEL")",
  "manufacturer": "$(omod_json_escape "$MANUF")",
  "revision": "$(omod_json_escape "$REV")",
  "imei": "$(omod_json_escape "$IMEI")",
  "sim_status": "$(omod_json_escape "$SIM_STATUS")",
  "sim_slot": "$(omod_json_escape "$SIM_SLOT")",
  "sim_slots": $SLOTS_JSON,
  "operator": "$(omod_json_escape "$OPERATOR")",
  "network": "$(omod_json_escape "$NETWORK")",
  "csq": "$(omod_json_escape "$CSQ")",
  "dbm": "$(omod_json_escape "$DBM")",
  "rsrp": "$(omod_json_escape "$RSRP")",
  "temperature": "$(omod_json_escape "$TEMPERATURE")",
  "iccid": "$(omod_json_escape "$ICCID")",
  "imsi": "$(omod_json_escape "$IMSI")",
  "reg_status": "$(omod_json_escape "$REG_STATUS")",
  "cells": [${CELLS_JSON}]
}
EOF
