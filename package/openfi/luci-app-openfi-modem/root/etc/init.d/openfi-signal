#!/bin/sh /etc/rc.common
#
# OpenFi 6C 信号历史采样
#   常驻进程只往 /tmp（tmpfs）写，不碰 flash。
#   改采样间隔/开关后保存配置 → procd 自动调 reload，HUP 让守护进程换新参数。
#
START=95
STOP=11
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/openfi-modem-signal daemon
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	local pids

	pids=$(pgrep -f '/usr/sbin/openfi-modem-signal daemon$' 2>/dev/null)
	if [ -n "$pids" ]; then
		for p in $pids; do kill -HUP "$p" 2>/dev/null; done
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger openfi_modem
}
