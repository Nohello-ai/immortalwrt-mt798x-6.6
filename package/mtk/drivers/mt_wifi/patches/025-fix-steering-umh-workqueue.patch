+#include <linux/workqueue.h>
+
+struct openfi_steer_umh {
+	struct work_struct work;
+	UCHAR addr[MAC_ADDR_LEN];
+	BOOLEAN is_2g;
+};
+
+static void openfi_steer_umh_work(struct work_struct *work)
+{
+	struct openfi_steer_umh *s = container_of(work, struct openfi_steer_umh, work);
+	char path[20] = {0}, arg1[6] = {0}, arg2[24] = {0};
+	char *argv[] = {path, arg1, arg2, NULL};
+	char *envp[] = {NULL};
+
+	snprintf(path, sizeof(path), "/sbin/steeringsta");
+	snprintf(arg1, sizeof(arg1), "%s", s->is_2g ? "ra0" : "rax0");
+	snprintf(arg2, sizeof(arg2), MACSTR, MAC2STR(s->addr));
+	/* call_usermodehelper 内部是 GFP_KERNEL 分配, 不能在 softirq/定时器上下文做 */
+	call_usermodehelper(path, argv, envp, UMH_NO_WAIT);
+	kfree(s);
+}
+
+static void openfi_steer_umh_schedule(const UCHAR *addr, BOOLEAN is_2g)
+{
+	struct openfi_steer_umh *s = kmalloc(sizeof(*s), GFP_ATOMIC);
+
+	if (!s)
+		return;
+	memcpy(s->addr, addr, MAC_ADDR_LEN);
+	s->is_2g = is_2g;
+	INIT_WORK(&s->work, openfi_steer_umh_work);
+	schedule_work(&s->work);
+}
