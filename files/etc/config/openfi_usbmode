config usbmode 'usbmode'
	# 开机自动探测模组最佳的 USB 数据模式。
	#
	#   auto —— 按 MBIM(2) → NCM(5) → RNDIS(3) 逐个试，哪个真通就用哪个，
	#           结果记在 /etc/openfi_usbmode.state，以后开机直接用
	#   off  —— 不探测，保持模组当前设置
	#   1/2/3/5 —— 钉死某个模式（不建议）
	#
	# 为什么是这个顺序：
	#   MBIM  没有模组内部 NAT，主机直接拿运营商 IP（少一跳）
	#   NCM   多包聚合，比 RNDIS 快一档，但仍保留模组内部 NAT
	#   RNDIS 兼容性最好、速度最差 —— 兜底，保证最坏情况=出厂状态
	#
	# 这颗 RM500U-CN 实际支持哪些（用 AT+QCFG=? 问出来的）：
	#   1(ECM) 2(MBIM) 3(RNDIS) 5(NCM) 11 13 15
	#   没有 0(RMNET) / 4(QMI) —— 展锐平台确实没实现高通那套
	#
	# 注意：切换模式会让模组重新枚举（等于 USB 拔插一次），WAN 断十几秒。
	# 首次开机会明显变慢（可能要试两三个），之后就读记录、秒过。
	option mode 'auto'

	# 上次探测失败过的模式会被记下来跳过，避免每次开机都在同一个坏模式上卡住。
	# 记录超过 7 天自动清空重试（换了位置/刷了固件/换了卡，之前不通的可能就通了）。
	# 想立刻重试：删掉 /etc/openfi_usbmode.state 再重启，或 /etc/init.d/openfi-usbmode restart
